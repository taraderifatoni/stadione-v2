[Unit]
Description=Publish approved scheduled Stadione Instagram content
After=stadione.service

[Service]
Type=oneshot
EnvironmentFile=/opt/stadione/.env.production
ExecStart=/usr/bin/python3 /opt/stadione-current/scripts/cms-publish-due.py
TimeoutStartSec=180
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=true

